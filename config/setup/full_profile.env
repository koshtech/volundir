BASE_URL="git@github.com:koshtech"
INGOTS="koshtech-base volundir volundir-bash volundir-help-base volundir-ruby volundir-ruby-server"
KOSHTECH_HOME="$HOME/.koshtech"
KOSHTECH_CONFIG="$KOSHTECH_HOME/config"
VOLUNDIR_ROOT="$KOSHTECH_HOME/volundir"
INGOTS_ROOT="$KOSHTECH_HOME/ingots"
CP_ROOT_FILES="volundir-ruby/support/Gemfile volundir-ruby/support/.ruby-version volundir-ruby/support/.ruby-gemset volundir-ruby/support/.volundir-ruby.development.env"
VOLUNDIR_ENV="development"

export BASE_URL\
  INGOTS\
  KOSHTECH_HOME\
  KOSHTECH_CONFIG\
  VOLUNDIR_ROOT\
  INGOTS_ROOT\
  BIN_LINKS\
  CP_ROOT_FILES\
  VOLUNDIR_ENV
